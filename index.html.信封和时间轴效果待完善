      <path d="M55 130 L62 128" stroke="#E35342" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
      <path d="M57 110 L60 108" stroke="#E35342" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
      <path d="M56 90 L61 88" stroke="#E35342" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
      <path d="M58 70 L59 68" stroke="#E35342" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
      <path d="M57 50 L60 48" stroke="#E35342" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
      <!-- 椰子叶 - 向下弯曲的曲线 -->
      <g stroke="#E35342" stroke-width="3" fill="none" stroke-linecap="round">
        <!-- 左侧叶子（向下） -->
        <path d="M58 15 Q40 25 30 35 Q22 42 15 48"/>
        <path d="M58 15 Q38 28 28 40 Q22 48 18 55"/>
        <path d="M58 15 Q42 30 35 42 Q30 50 25 58"/>
        <path d="M58 15 Q45 22 35 32 Q28 40 22 48"/>
        <!-- 右侧叶子（向下） -->
        <path d="M60 15 Q78 25 88 35 Q96 42 103 48"/>
        <path d="M60 15 Q80 28 90 40 Q96 48 100 55"/>
        <path d="M60 15 Q76 30 83 42 Q88 50 93 58"/>
