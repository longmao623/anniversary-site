    <div class="photo-grid" style="position: relative; height: 850px; background-image: linear-gradient(rgba(242,227,207,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(242,227,207,0.15) 1px, transparent 1px); background-size: 40px 40px; background-position: center center;">
      <div class="polaroid" style="transform:rotate(-2deg)">
