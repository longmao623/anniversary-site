  <!-- 结尾 - 位于网页内容最底部（需要滚动到最下方才能看到） -->
  <section style="height: 80vh; min-height: 600px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; text-align: center; padding-bottom: 80px; margin-top: 100px; position: relative;">
    <p id="line1" style="font-size: 2rem; font-family: 'Caveat', cursive; margin-bottom: 1.5rem;">波浪在海面上</p>
    <p id="line2" style="font-size: 2rem; font-family: 'Dancing Script', cursive; color: #E35342; margin-bottom: 1.5rem;">萤火在岸边</p>
    <div style="border: 3px solid #E35342; border-radius: 12px; padding: 20px 40px; display: inline-block; margin-bottom: 1.5rem; background: rgba(242,227,207,0.1);">
