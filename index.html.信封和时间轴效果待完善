    </div>
    <p style="font-size: 0.9rem; opacity: 0.5; font-family: 'Gochi Hand', cursive;">Made with love</p>
    <!-- 底部装饰线条 -->
    <div style="width: 200px; height: 3px; background: linear-gradient(90deg, transparent, #E35342, transparent); margin-top: 30px; opacity: 0.5;"></div>
    
    <!-- 海浪和椰子树装饰 - 页面底端（随滚动） -->
    <!-- 海浪线条 - 左下角（海浪 + 落日整体设计） -->
    <svg class="hand-drawn-decoration" width="280" height="100" viewBox="0 0 280 100" style="position: absolute; bottom: 0; left: 0; pointer-events: none;">
      <!-- 定义裁剪区域：只保留海浪上方的部分 -->
      <defs>
        <clipPath id="sunset-clip">
          <rect x="0" y="0" width="280" height="65"/>
        </clipPath>
      </defs>
      
      <!-- 落日（使用裁剪，被海浪遮挡的部分消失） -->
      <g opacity="0.8" clip-path="url(#sunset-clip)">
        <circle cx="140" cy="62" r="25" stroke="#E35342" stroke-width="2.5" fill="none" stroke-linecap="round"/>
        <circle cx="140" cy="62" r="18" stroke="#E35342" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6"/>
        <circle cx="140" cy="62" r="6" fill="#E35342" opacity="0.9"/>
        <!-- 太阳光芒（手绘线条，向上发散） -->
