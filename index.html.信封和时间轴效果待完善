<!-- 拖动照片 JS - 修复版 -->
<script>
  const photos = document.querySelectorAll('.polaroid');
  let active = null;
  let offsetX = 0;
  let offsetY = 0;
  let isDragging = false;

  // 开始拖动
  const startDrag = (e, photo) => {
    e.preventDefault();
    active = photo;
    isDragging = true;
    
    // 获取当前位置
    const rect = photo.getBoundingClientRect();
    const clientX = e.clientX || e.touches[0].clientX;
    const clientY = e.clientY || e.touches[0].clientY;
    
    // 计算鼠标相对于照片左上角的偏移
    offsetX = clientX - rect.left;
    offsetY = clientY - rect.top;
    
    // 设置拖动样式
    photo.style.zIndex = 1000;
    photo.style.transition = 'none';
    photo.style.cursor = 'grabbing';
    photo.style.transform = photo.style.transform.replace('scale(1)', '') + ' scale(1.05)';
    
    // 将照片设为 fixed 定位，相对于视口
    photo.style.position = 'fixed';
    photo.style.left = rect.left + 'px';
    photo.style.top = rect.top + 'px';
  };

  // 移动拖动
  const moveDrag = (e) => {
    if (!active || !isDragging) return;
    e.preventDefault();
    
    const clientX = e.clientX || e.touches[0].clientX;
    const clientY = e.clientY || e.touches[0].clientY;
    
    // 计算新位置（相对于视口）
    let newX = clientX - offsetX;
    let newY = clientY - offsetY;
    
    // 限制在视口范围内（整个屏幕）
    const photoWidth = active.offsetWidth;
    const photoHeight = active.offsetHeight;
    
    // 留出边距，不要贴边
    const margin = 20;
    newX = Math.max(margin, Math.min(newX, window.innerWidth - photoWidth - margin));
    newY = Math.max(margin, Math.min(newY, window.innerHeight - photoHeight - margin));
    
    // 应用新位置
    active.style.left = newX + 'px';
    active.style.top = newY + 'px';
  };

  // 结束拖动
  const endDrag = () => {
    if (!active) return;
    
    // 获取当前的 fixed 位置（相对于视口）
    const rect = active.getBoundingClientRect();
    const viewportLeft = rect.left;
    const viewportTop = rect.top;
    
    // 获取当前滚动位置
    const scrollX = window.pageXOffset || document.documentElement.scrollLeft;
    const scrollY = window.pageYOffset || document.documentElement.scrollTop;
    
    // 计算相对于文档的位置
    const pageLeft = viewportLeft + scrollX;
    const pageTop = viewportTop + scrollY;
    
    // 将照片移动到 body 层级，避免父容器影响
    document.body.appendChild(active);
    
    // 恢复样式，改为 absolute 定位（相对于 body）
    active.style.position = 'absolute';
    active.style.left = pageLeft + 'px';
    active.style.top = pageTop + 'px';
    active.style.zIndex = '';
    active.style.transition = 'transform 0.2s ease';
    active.style.cursor = 'grab';
    active.style.transform = active.style.transform.replace('scale(1.05)', '');
    
    active = null;
    isDragging = false;
  };

  // 为每张照片添加事件监听
  photos.forEach(photo => {
    photo.addEventListener('mousedown', (e) => startDrag(e, photo));
    photo.addEventListener('touchstart', (e) => startDrag(e, photo), {passive: false});
  });

  document.addEventListener('mousemove', moveDrag);
  document.addEventListener('touchmove', moveDrag, {passive: false});
  document.addEventListener('mouseup', endDrag);
  document.addEventListener('touchend', endDrag);
  
  // 防止拖拽时选中文字
  document.addEventListener('selectstart', (e) => {
    if (isDragging) e.preventDefault();
  });

  // 爱心粒子效果
  document.addEventListener('click', (e) => {
    // 如果点击的是照片，不触发爱心效果
    if (e.target.closest('.polaroid')) return;
    
    const heartCount = Math.floor(Math.random() * 3) + 1;
    
    for (let i = 0; i < heartCount; i++) {
      const heart = document.createElement('span');
      heart.innerText = '❤';
      heart.style.position = 'fixed';
      const offsetX = (Math.random() - 0.5) * 30;
      const offsetY = (Math.random() - 0.5) * 30;
      heart.style.left = (e.clientX + offsetX) + 'px';
      heart.style.top = (e.clientY + offsetY) + 'px';
      heart.style.color = '#E35342';
      heart.style.pointerEvents = 'none';
      heart.style.fontSize = '13px';
      const animationDuration = 0.8 + Math.random() * 0.4;
      heart.style.animation = `float ${animationDuration}s forwards`;
      document.body.appendChild(heart);
      setTimeout(() => heart.remove(), animationDuration * 1000);
    }
  });

  // 添加浮动动画
  const style = document.createElement('style');
  style.innerHTML = `
    @keyframes float { 
      0% { transform: translateY(0); opacity: 1; } 
      100% { transform: translateY(-60px); opacity: 0; } 
    }
  `;
  document.head.appendChild(style);

  // ========== 信封打開動畫 ==========
  const envelope = document.getElementById("envelope");
  envelope.addEventListener("click", () => {
    envelope.classList.add("open");
    setTimeout(() => {
      envelope.style.opacity = "0";
      envelope.style.pointerEvents = "none";
    }, 1000);
  });

  // ========== 時間線滾動觸發動畫 ==========
  // 修改 SVG path 添加動畫
  const originalDrawTimeline = drawTimelineLines;
  drawTimelineLines = function() {
    originalDrawTimeline();
    const paths = document.querySelectorAll('#timeline-svg path');
    paths.forEach(path => {
      const length = path.getTotalLength();
      path.style.strokeDasharray = length;
      path.style.strokeDashoffset = length;
      path.style.transition = "stroke-dashoffset 1.5s ease";
    });
  };
  drawTimelineLines();

  // IntersectionObserver 觸發線條繪製
  const timelineObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const paths = document.querySelectorAll('#timeline-svg path');
        paths.forEach((p, i) => {
          setTimeout(() => {
            p.style.strokeDashoffset = 0;
          }, i * 300);
        });
      }
    });
  }, { threshold: 0.3 });

  const timelineSection = document.querySelector('.timeline-horizontal');
  if (timelineSection) {
    timelineObserver.observe(timelineSection);
  }

  // 卡片逐個出現動畫
  const items = document.querySelectorAll('.timeline-item');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');

        // 等出现后再画线，确保位置稳定
        setTimeout(() => {
          drawTimelineLines();
        }, 100);
      }
    });
  }, { threshold: 0.3 });

  items.forEach(item => observer.observe(item));

  // ========== 結尾打字機效果 ==========
  function typeText(el, text, speed = 60) {
    el.innerHTML = "";
    el.style.opacity = 1;

    let i = 0;

    function typing() {
      if (i < text.length) {
        el.innerHTML += text.charAt(i);
        i++;
        setTimeout(typing, speed);
      }
    }

    typing();
  }

  let triggered = false;

  window.addEventListener("scroll", () => {
    const scrollBottom = window.innerHeight + window.scrollY;
    const fullHeight = document.body.offsetHeight;

    if (!triggered && scrollBottom >= fullHeight - 50) {
      triggered = true;

      const l1 = document.getElementById("line1");
      const l2 = document.getElementById("line2");

      const t1 = l1.textContent;
      const t2 = l2.textContent;

      typeText(l1, t1);

      setTimeout(() => {
        typeText(l2, t2);
      }, 1200);
    }
  });
</script>

