      <path d="M0 30 Q30 20 60 30 Q90 40 120 30 Q150 20 180 30 Q210 40 250 30" stroke="#E35342" stroke-width="3" fill="none" stroke-linecap="round"/>
      <path d="M0 38 Q25 32 50 38 Q75 44 100 38 Q125 32 150 38 Q175 44 200 38 Q225 32 250 38" stroke="#E35342" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.7"/>
      <path d="M150 45 Q170 40 190 45 Q210 50 230 45" stroke="#E35342" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.5"/>
    </svg>
    
    <!-- 椰子树装饰 - 手绘涂鸦风格（树叶向下） -->
    <svg class="hand-drawn-decoration tree-decoration" width="120" height="180" viewBox="0 0 120 180" style="position: absolute; bottom: 0; right: 60px; pointer-events: none;">
      <!-- 树干 - 手绘弯曲线条 -->
      <path d="M55 170 Q58 140 56 110 Q54 80 57 50 Q59 30 58 15" stroke="#E35342" stroke-width="4" fill="none" stroke-linecap="round"/>
      <path d="M62 170 Q60 140 62 110 Q60 80 63 50 Q61 30 62 15" stroke="#E35342" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.8"/>
      <!-- 树干纹理 - 涂鸦线条 -->
