            <div class="timeline-dot" style="position: absolute; top: 10px; left: 50%; transform: translateX(-50%); width: 14px; height: 14px; background: #E35342; border-radius: 3px; box-shadow: 2px 2px 4px rgba(0,0,0,0.3); z-index: 10;"></div>
            <span class="bg-[#E35342] text-white px-3 py-1 rounded-full text-sm font-gochi">2026.04.14</span>
