  <!-- 留白区域 - Hero和时间轴之间 -->
  <section style="height: 25vh; min-height: 200px;"></section>

  <!-- 水平时间线 -->
  <section class="py-20 px-4">
    <h2 class="text-4xl md:text-5xl font-caveat text-center mb-16">我们的故事</h2>
    
    <div class="timeline-horizontal">
      <!-- 垂坠线 SVG（由 JavaScript 动态绘制） -->
      <svg id="timeline-svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5;"></svg>
      <script>
        function drawTimelineLines() {
          const svg = document.getElementById('timeline-svg');
          const container = document.querySelector('.timeline-horizontal');
          const dots = document.querySelectorAll('.timeline-dot');
          
          if (dots.length < 4) return;
          
          const containerRect = container.getBoundingClientRect();
          
          // 获取每个节点的精确位置
          const positions = [];
          dots.forEach((dot, index) => {
            const rect = dot.getBoundingClientRect();
            positions.push({
              x: rect.left - containerRect.left + rect.width / 2,
              y: rect.top - containerRect.top + rect.height / 2
            });
          });
          
          // 清除旧线条
          svg.innerHTML = '';
          
          // 绘制三条垂坠线
          const pairs = [[0, 1], [1, 2], [2, 3]];
          pairs.forEach(([start, end]) => {
            const p1 = positions[start];
            const p2 = positions[end];
            
            // 计算控制点（用于垂坠效果）
            const midX = (p1.x + p2.x) / 2;
            const midY = (p1.y + p2.y) / 2;
            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            const distance = Math.sqrt(dx * dx + dy * dy);
            
            // 控制点向下偏移，创造垂坠感
            const controlOffset = distance * 0.5;
            const controlX = midX;
            const controlY = Math.max(p1.y, p2.y) + controlOffset;
            
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', `M ${p1.x} ${p1.y} Q ${controlX} ${controlY} ${p2.x} ${p2.y}`);
            path.setAttribute('stroke', '#E35342');
            path.setAttribute('stroke-width', '3');
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke-linecap', 'round');
            path.setAttribute('opacity', '0.9');
            
            // 添加动画
            const length = path.getTotalLength();
            path.style.strokeDasharray = length;
            path.style.strokeDashoffset = length;
            path.style.transition = "stroke-dashoffset 1.2s ease";
            
            svg.appendChild(path);
            
            setTimeout(() => {
              path.style.strokeDashoffset = 0;
            }, 50);
          });
        }
        
        // 页面加载和窗口大小改变时绘制
        window.addEventListener('load', drawTimelineLines);
        window.addEventListener('resize', drawTimelineLines);
      </script>

      <div class="timeline-items">
        <!-- 卡片1 - 上方 -->
