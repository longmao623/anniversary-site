// ========== 照片翻转 ==========
  function flipCard(event, btn) {
    event.stopPropagation();
    event.preventDefault();
    const polaroid = btn.closest('.polaroid');
    polaroid.classList.toggle('flipped');
  }

  // ========== Hero 标题 stagger 入场 ==========
  // Hero 入场由 CSS @keyframes heroTextFadeIn 驱动，无需 JS

  // ========== 卡片逐个出现动画 ==========
  const items = document.querySelectorAll('.timeline-item');
  const cardObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  }, { threshold: 0.1 });
  items.forEach(item => cardObserver.observe(item));

  // ========== 通用滚动入场动画 ==========
  const revealEls = document.querySelectorAll('.reveal-on-scroll');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  }, { threshold: 0.15 });
  revealEls.forEach(el => revealObserver.observe(el));

  // ========== 结尾打字机效果 + 入场 ==========
  function typeText(el, text, speed = 60) {
    el.innerHTML = "";
    el.style.opacity = 1;
    let i = 0;
    function typing() {
      if (i < text.length) {
        el.innerHTML += text.charAt(i);
        i++;
        setTimeout(typing, speed);
      }
    }
    typing();
  }

  let triggered = false;
  window.addEventListener("scroll", () => {
    const scrollBottom = window.innerHeight + window.scrollY;
    const fullHeight = document.body.offsetHeight;
    if (!triggered && scrollBottom >= fullHeight - 200) {
      triggered = true;
      const l1 = document.getElementById("line1");
      const l2 = document.getElementById("line2");
      const t1 = l1.textContent;
      const t2 = l2.textContent;
      typeText(l1, t1);
      setTimeout(() => {
        typeText(l2, t2);
      }, 1200);
    }
  });

  // ========== Canvas 手绘铁路 ==========
  function drawRailway() {
    const canvas = document.getElementById('railway-canvas');
    const main = document.querySelector('main');
    if (!canvas || !main) return;

    // 移动端不画铁轨（屏幕窄 + Canvas 兼容性问题）
    if (window.innerWidth < 768) {
      canvas.width = 0;
      canvas.height = 0;
      return;
    }

    const dpr = window.devicePixelRatio || 1;
    const w = main.offsetWidth;
    const h = main.offsetHeight;

    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';

    const ctx = canvas.getContext('2d');
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, w, h);

    // 收集轨道点数组
    const points = [];

    // 通过 getBoundingClientRect 精确测量内容元素在 main 内的位置
    function getRange(selector) {
      const el = document.querySelector(selector);
      if (!el) return [0, 0];
      const mainRect = main.getBoundingClientRect();
      const rect = el.getBoundingClientRect();
      return [
        rect.top - mainRect.top,
        rect.bottom - mainRect.top
      ];
    }

    const [tY1, tY2] = getRange('.timeline-items');
    const [pY1, pY2] = getRange('.photo-grid');
    const [fY1, fY2] = getRange('.ending-section');

    // Hero 结束于时间线开始处（包含中间留白）
    const heroEnd = tY1;
    const fadeMarginTop = 80;
    const fadeMarginBottom = 200;

    // 轨道中心线：叙事路径 - 从左上绕行标题，穿过卡片和照片墙到右下
    function getTrackX(y) {
      const vanishX = w * 0.05;  // 左上角消失点

      // 叙事关键帧：(页面高度比例, 目标x比例)
      const keyframes = [
        { yp: 0.00, xp: 0.05 },  // 起点：极左上
        { yp: 0.15, xp: 0.32 },  // Hero 绕行顶点（标题右侧）
        { yp: 0.28, xp: 0.22 },  // 离开 Hero，偏左进入时间线
        { yp: 0.38, xp: 0.40 },  // 时间线前半（卡片1-2）
        { yp: 0.48, xp: 0.58 },  // 时间线后半（卡片3-4）
        { yp: 0.62, xp: 0.65 },  // 照片墙
        { yp: 0.78, xp: 0.72 },  // 留白过渡
        { yp: 1.00, xp: 0.82 },  // 结尾：右下
      ];

      const py = y / h;
      let prev = keyframes[0];
      let next = keyframes[1];

      // 找到当前段
      for (let i = 0; i < keyframes.length - 1; i++) {
        if (py >= keyframes[i].yp && py <= keyframes[i + 1].yp) {
          prev = keyframes[i];
          next = keyframes[i + 1];
          break;
        }
      }

      // ease-in-out 插值
      const rawT = (py - prev.yp) / Math.max(next.yp - prev.yp, 0.001);
      const t = rawT < 0.5
        ? 2 * rawT * rawT
        : 1 - Math.pow(-2 * rawT + 2, 2) / 2;

      const narrativeX = vanishX + (prev.xp + (next.xp - prev.xp) * t) * w;

      // 装饰性小波动（近处才有）
      const perspective = getPerspective(y);
      const wave = Math.sin(y * 0.012 + 0.3) * 20 * perspective
                 + Math.sin(y * 0.025 + 1.7) * 8 * perspective;

      return narrativeX + wave;
    }

    // 透视因子复用
    function getPerspective(y) {
      const k = 3 / Math.max(heroEnd, 300);
      return 1 - Math.exp(-k * y);
    }

    // 透视效果：轨道从远处（很窄）延伸过来，逐渐变宽
    function getTrackHalfWidth(y) {
      const perspective = getPerspective(y);
      return 0.2 + perspective * 6.8; // y=0 处 0.2px，远处趋近 0px
    }

    // 收集所有点——全页贯通，仅在内容区降低透明度
    for (let y = 0; y < h; y += 3) {
      const x = getTrackX(y);
      const trackHalfWidth = getTrackHalfWidth(y);

      let opacity = 0.7;

      // 顶部淡入
      if (y < fadeMarginTop) {
        opacity *= Math.max(0, y / fadeMarginTop);
      }

      // 照片墙区域：铁轨隐约藏在内容之下
      if (y >= pY1 && y <= pY2) {
        opacity *= 0.1;
      }

      // 底部淡出——延续到结尾区最底部
      if (y > fY2 - fadeMarginBottom) {
        opacity *= Math.max(0, (fY2 - y) / fadeMarginBottom);
      }

      if (opacity <= 0.005) continue;

      points.push({ x, y, opacity, trackHalfWidth });
    }

    if (points.length < 3) return;

    // 计算每个点的切线方向
    for (let i = 0; i < points.length; i++) {
      const prev = points[Math.max(0, i - 1)];
      const next = points[Math.min(points.length - 1, i + 1)];
      points[i].angle = Math.atan2(next.y - prev.y, next.x - prev.x);
    }

    // 轨道线宽也随透视变化
    function getLineWidth(trackHalfWidth) {
      return 1.2 + (trackHalfWidth / 7) * 1.8;
    }

    // 画左轨
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#E35342';
    for (let i = 1; i < points.length; i++) {
      const p = points[i];
      const prev = points[i - 1];
      const perpX = -Math.sin(p.angle);
      const perpY = Math.cos(p.angle);
      ctx.globalAlpha = p.opacity;
      ctx.lineWidth = getLineWidth(p.trackHalfWidth);
      ctx.beginPath();
      ctx.moveTo(prev.x + perpX * p.trackHalfWidth, prev.y + perpY * p.trackHalfWidth);
      ctx.lineTo(p.x + perpX * p.trackHalfWidth, p.y + perpY * p.trackHalfWidth);
      ctx.stroke();
    }

    // 画右轨
    for (let i = 1; i < points.length; i++) {
      const p = points[i];
      const prev = points[i - 1];
      const perpX = Math.sin(p.angle);
      const perpY = -Math.cos(p.angle);
      ctx.globalAlpha = p.opacity;
      ctx.lineWidth = getLineWidth(p.trackHalfWidth);
      ctx.beginPath();
      ctx.moveTo(prev.x + perpX * p.trackHalfWidth, prev.y + perpY * p.trackHalfWidth);
      ctx.lineTo(p.x + perpX * p.trackHalfWidth, p.y + perpY * p.trackHalfWidth);
      ctx.stroke();
    }

    // 画枕木（长度、粗细、间距都随透视变化）
    let lastTieY = -999;
    for (let i = 0; i < points.length; i++) {
      const p = points[i];
      const perspective = Math.max(0.25, getPerspective(p.y));
      // 远处枕木更密集（间距缩小），近处正常
      const spacing = (14 + Math.random() * 12 + p.trackHalfWidth * 0.5) * perspective;
      if (p.y - lastTieY < spacing) continue;
      lastTieY = p.y;

      const len = p.trackHalfWidth * 2.6;
      const skew = (Math.random() - 0.5) * 0.35;

      const px = -Math.sin(p.angle + skew);
      const py = Math.cos(p.angle + skew);

      ctx.lineWidth = 0.8 + (p.trackHalfWidth / 7) * 1.2;
      ctx.globalAlpha = p.opacity * 0.55;
      ctx.beginPath();
      ctx.moveTo(p.x - px * len, p.y - py * len);
      ctx.lineTo(p.x + px * len, p.y + py * len);
      ctx.stroke();
    }

    ctx.globalAlpha = 1;
  }

  window.addEventListener('load', drawRailway);
  window.addEventListener('resize', drawRailway);
</script>

<script>
  // Polaroid hover — 保留原有 rotate 角度，叠加上浮和微缩放
  document.querySelectorAll('.polaroid').forEach(p => {
    const originalTransform = p.style.transform;
    p.addEventListener('mouseenter', () => {
      if (p.classList.contains('flipped')) return;
      if (p.style.position === 'fixed' || p.style.position === 'absolute') return;
      p.style.transform = originalTransform + ' translateY(-8px) scale(1.02)';
    });
    p.addEventListener('mouseleave', () => {
      if (p.classList.contains('flipped')) return;
      if (p.style.position === 'fixed' || p.style.position === 'absolute') return;
      p.style.transform = originalTransform;
    });
  });
</script>

