<!-- 拖动照片 JS - 延迟 DOM 操作版 -->
  <script>
    const photos = document.querySelectorAll('.polaroid');
    let active = null;
    let placeholder = null;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let hasMoved = false;
    let offsetX = 0;
    let offsetY = 0;
    let originalRotate = '';
    let initialRect = null;

    // 从 style 中提取 rotate 角度
    function getRotate(style) {
      const m = style.match(/rotate\([^)]+\)/);
      return m ? m[0] : 'rotate(0deg)';
    }

    // 开始拖动 - 只记录状态，不动 DOM
    const startDrag = (e, photo) => {
      if (e.target.closest('.flip-btn')) return;
      if (photo.classList.contains('flipped')) return;
      e.preventDefault();
      active = photo;
      isDragging = true;
      hasMoved = false;
      placeholder = null;
      initialRect = null;

      const rect = photo.getBoundingClientRect();
      const clientX = e.clientX || e.touches[0].clientX;
      const clientY = e.clientY || e.touches[0].clientY;
      dragStartX = clientX;
      dragStartY = clientY;
      offsetX = clientX - rect.left;
      offsetY = clientY - rect.top;
      originalRotate = getRotate(photo.style.transform || '');
      initialRect = rect;
    };

    // 移动拖动
    const moveDrag = (e) => {
      if (!active || !isDragging) return;
      e.preventDefault();

      const clientX = e.clientX || e.touches[0].clientX;
      const clientY = e.clientY || e.touches[0].clientY;

      if (!hasMoved) {
        const dx = Math.abs(clientX - dragStartX);
        const dy = Math.abs(clientY - dragStartY);
        if (dx > 12 || dy > 12) {
          hasMoved = true;
          // 第一次真正移动时，才创建 placeholder 和移动 DOM
          placeholder = document.createElement('div');
          placeholder.style.width = initialRect.width + 'px';
          placeholder.style.height = initialRect.height + 'px';
          placeholder.style.flexShrink = '0';
          placeholder.className = 'polaroid-placeholder';
          active.parentNode.insertBefore(placeholder, active);
          document.body.appendChild(active);
          active.style.position = 'fixed';
          active.style.left = initialRect.left + 'px';
          active.style.top = initialRect.top + 'px';
          active.style.zIndex = 1000;
          active.style.transition = 'none';
          active.style.cursor = 'grabbing';
          active.style.transform = `${originalRotate} scale(1.05)`;
          active.style.margin = '0';
        } else {
          return; // 还没移动够，不处理
        }
      }

      let newX = clientX - offsetX;
      let newY = clientY - offsetY;

      // 限制在视口范围内
      const photoWidth = active.offsetWidth;
      const photoHeight = active.offsetHeight;
      const margin = 20;
      newX = Math.max(margin, Math.min(newX, window.innerWidth - photoWidth - margin));
      newY = Math.max(margin, Math.min(newY, window.innerHeight - photoHeight - margin));

      active.style.left = newX + 'px';
      active.style.top = newY + 'px';
    };

    // 结束拖动
    const endDrag = () => {
      if (!active) return;

      if (!hasMoved) {
        // 完全没有移动过，什么也不需要做
        active = null;
        placeholder = null;
        isDragging = false;
        initialRect = null;
        return;
      }

      // 真正移动了，转为 absolute（随页面滚动）
      const rect = active.getBoundingClientRect();
      const scrollX = window.pageXOffset || document.documentElement.scrollLeft;
      const scrollY = window.pageYOffset || document.documentElement.scrollTop;

      active.style.position = 'absolute';
      active.style.left = (rect.left + scrollX) + 'px';
      active.style.top = (rect.top + scrollY) + 'px';
      active.style.zIndex = '';
      active.style.transition = 'transform 0.2s ease';
      active.style.cursor = 'grab';
      active.style.transform = originalRotate;

      active = null;
      placeholder = null;
      isDragging = false;
      initialRect = null;
    };

    // 为每张照片添加事件监听
    const LONG_PRESS = 400;
    photos.forEach(photo => {
      let pressTimer = null;

      photo.addEventListener('mousedown', (e) => startDrag(e, photo));
      photo.addEventListener('touchstart', (e) => {
        // 点击翻转按钮时不启动长按计时
        if (e.target.closest('.flip-btn')) return;
        pressTimer = setTimeout(() => {
          pressTimer = null;
          const btn = photo.querySelector('.flip-btn');
          if (btn) flipCard(e, btn);
        }, LONG_PRESS);
        startDrag(e, photo);
      }, {passive: false});
      photo.addEventListener('touchmove', () => {
        if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; }
      });
      photo.addEventListener('touchend', () => {
        if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; }
      });
    });

    document.addEventListener('mousemove', moveDrag);
    document.addEventListener('touchmove', moveDrag, {passive: false});
    document.addEventListener('mouseup', endDrag);
    document.addEventListener('touchend', endDrag);

    // 防止拖拽时选中文字
    document.addEventListener('selectstart', (e) => {
      if (isDragging) e.preventDefault();
    });

  </script>

